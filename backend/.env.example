# Stack Exchange API (opcional - para aumentar cota de requisições de 300 para 10.000/dia)
# Obtenha uma key em: https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=
STACKEXCHANGE_USER_AGENT=StackOverflow IR Project/1.0.0

# Método de Recuperação da Informação padrão: 'tfidf' (Vector Space Model) ou 'boolean' (Modelo Booleano)
RETRIEVAL_MODEL=tfidf

# Servidor
PORT=3001

# Banco de dados (arquivo SQLite)
DB_PATH=./data/retrova.db
